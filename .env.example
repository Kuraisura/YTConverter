# Required: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Required: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for reliable public YouTube metadata
YOUTUBE_API_KEY=

# Optional: absolute path to a Netscape-format cookie export on this PC
# Use forward slashes or escaped backslashes on Windows.
YOUTUBE_COOKIES_PATH=C:/Users/your-name/youtube-cookies.txt

# Cleanup and file lifetime
CLEANUP_CRON_TOKEN=
CLEANUP_DELETE_JOB_IMMEDIATE=false
CLEANUP_DELAY_MS=600000
R2_PRESIGNED_EXPIRES_SEC=172800
JOB_EXPIRATION_SEC=172800

# Local server settings
PORT=3000
WORKER_API_URL=http://127.0.0.1:3000
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
# Interrupted jobs are automatically returned to the queue after this period.
PROCESSING_LEASE_MS=600000

# Anonymous public-use protection
RATE_LIMIT_SECRET=
CONVERSION_RATE_LIMIT=5
CONVERSION_RATE_WINDOW_SEC=600
MAX_ACTIVE_JOBS_PER_CLIENT=5
MAX_QUEUE_DEPTH=30
MAX_QUEUE_WAIT_MS=30000
CLIENT_JOB_TTL_SEC=7200

# Set true only on Render when this PC should be the sole conversion worker.
DISABLE_QUEUE_WORKER=false
